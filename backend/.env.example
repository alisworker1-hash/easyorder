# --- Database (managed Postgres: Supabase / Neon / Railway). Use the async driver. ---
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/easyorder

# --- CORS: your REAL site origin(s), comma-separated. No wildcards in production. ---
ALLOWED_ORIGINS=http://localhost:8042,https://alisworker1-hash.github.io

# --- Managed auth (Clerk / Auth0 / Supabase). The frontend obtains a JWT; we only verify it. ---
AUTH_ISSUER=https://YOUR-TENANT.example.com/
AUTH_AUDIENCE=easyorder-api
AUTH_JWKS_URL=https://YOUR-TENANT.example.com/.well-known/jwks.json

# DEV ONLY: "1" skips JWT verification and uses a fixed dev user + creates tables on startup.
# NEVER set this to 1 in production.
DEV_AUTH_BYPASS=0

# --- Stripe: SERVER-SIDE ONLY. Never place these in any client/static file. ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
